set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[5] -entity de25_nano_top
set_location_assignment PIN_AV16 -to HDMI_TX_D[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[6] -entity de25_nano_top
set_location_assignment PIN_AV11 -to HDMI_TX_D[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[7] -entity de25_nano_top
set_location_assignment PIN_BH11 -to HDMI_TX_D[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[8] -entity de25_nano_top
set_location_assignment PIN_BE14 -to HDMI_TX_D[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[9] -entity de25_nano_top
set_location_assignment PIN_BE19 -to HDMI_TX_D[10]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[10] -entity de25_nano_top
set_location_assignment PIN_BH14 -to HDMI_TX_D[11]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[11] -entity de25_nano_top
set_location_assignment PIN_BV6 -to HDMI_TX_D[12]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[12] -entity de25_nano_top
set_location_assignment PIN_BJ23 -to HDMI_TX_D[13]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[13] -entity de25_nano_top
set_location_assignment PIN_BV4 -to HDMI_TX_D[14]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[14] -entity de25_nano_top
