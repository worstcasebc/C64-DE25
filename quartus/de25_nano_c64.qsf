# de25_nano_c64.qsf — Quartus Prime Pro Projekteinstellungen
# Pins laut DE25-Nano User Manual und Terasic golden_top.qsf, siehe docs/pinout.md

set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY de25_nano_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- Quellen ---------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../rtl/de25_nano_top.v
set_global_assignment -name VERILOG_FILE ../rtl/io/blink.v
set_global_assignment -name VERILOG_FILE ../rtl/io/sync_2ff.v
set_global_assignment -name VERILOG_FILE ../rtl/io/uart_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/soc_c64.v
set_global_assignment -name VERILOG_FILE ../rtl/cpu/cpu_6502.v
set_global_assignment -name VERILOG_FILE ../rtl/cpu/cpu_port.v
set_global_assignment -name VERILOG_FILE ../rtl/cpu/vendor/arlet_6502/cpu.v
set_global_assignment -name VERILOG_FILE ../rtl/cpu/vendor/arlet_6502/ALU.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/c64_addr_decode.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/ram_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/rom_sync.v
set_global_assignment -name SDC_FILE de25_nano_c64.sdc

# --- Takt (Tabelle 3-6) ----------------------------------------------------
set_location_assignment PIN_DJ35 -to CLOCK0_50
set_instance_assignment -name IO_STANDARD "1.1 V" -to CLOCK0_50

# --- Taster, low-aktiv, per Schmitt-Trigger entprellt (Tabelle 3-9) ---------
set_location_assignment PIN_C8  -to KEY[0]
set_location_assignment PIN_C11 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[1]

# --- Schiebeschalter, oben = 1, nicht entprellt (Tabelle 3-8) ---------------
set_location_assignment PIN_DK24 -to SW[0]
set_location_assignment PIN_DD24 -to SW[1]
set_location_assignment PIN_DD27 -to SW[2]
set_location_assignment PIN_DF27 -to SW[3]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[0]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[1]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[2]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[3]

# --- LEDs, low-aktiv (Tabelle 3-10) -----------------------------------------
set_location_assignment PIN_DF35 -to LEDR[0]
set_location_assignment PIN_DJ32 -to LEDR[1]
set_location_assignment PIN_DN22 -to LEDR[2]
set_location_assignment PIN_DP23 -to LEDR[3]
set_location_assignment PIN_DN25 -to LEDR[4]
set_location_assignment PIN_DP25 -to LEDR[5]
set_location_assignment PIN_DJ27 -to LEDR[6]
set_location_assignment PIN_DP30 -to LEDR[7]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[0]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[1]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[2]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[3]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[4]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[5]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[6]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[7]
# --- FPGA-UART über den Onboard-FTDI (Terasic golden_top.qsf) ----------------
set_location_assignment PIN_CJ1 -to FPGA_UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_UART_TX

set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"
set_global_assignment -name IP_FILE ip/pll_sys.ip
set_global_assignment -name IP_FILE ip/reset_release.ip
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE de25_nano_c64.stp
set_global_assignment -name SIGNALTAP_FILE de25_nano_c64.stp
