# de25_nano_c64.qsf — Quartus Prime Pro Projekteinstellungen
# Pins laut DE25-Nano User Manual und Terasic golden_top.qsf, siehe docs/pinout.md

set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY de25_nano_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# --- Quellen ---------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../rtl/de25_nano_top.v
set_global_assignment -name VERILOG_FILE ../rtl/io/blink.v
set_global_assignment -name VERILOG_FILE ../rtl/io/sync_2ff.v
set_global_assignment -name VERILOG_FILE ../rtl/io/uart_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/io/i2c_write.v
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/io/vendor/mister_cia/mos6526.sv
set_global_assignment -name VERILOG_FILE ../rtl/io/uart_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/io/key_matrix.v
set_global_assignment -name VERILOG_FILE ../rtl/io/ascii_key_typer.v
set_global_assignment -name VERILOG_FILE ../rtl/io/prg_loader.v
set_global_assignment -name VERILOG_FILE ../rtl/video/video_timing.v
set_global_assignment -name VERILOG_FILE ../rtl/video/video_colorbars.v
set_global_assignment -name VERILOG_FILE ../rtl/video/video_scandoubler.v
set_global_assignment -name VERILOG_FILE ../rtl/video/video_upscaler.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/ram_2clk.v
set_global_assignment -name VERILOG_FILE ../rtl/video/c64_palette.v
set_global_assignment -name VHDL_FILE ../rtl/video/vendor/fpga64/video_vicII_656x.vhd
set_global_assignment -name VERILOG_FILE ../rtl/audio/i2s_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/audio/audio_boxcar.v
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_voice.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_tables.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_envelope.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/audio/vendor/mister_sid/sid_dac.sv
set_global_assignment -name VERILOG_FILE ../rtl/video/hdmi_config.v
set_global_assignment -name VERILOG_FILE ../rtl/soc_c64.v
set_global_assignment -name VHDL_FILE ../rtl/cpu/vendor/t65/T65_Pack.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/vendor/t65/T65_MCode.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/vendor/t65/T65_ALU.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/vendor/t65/T65.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/cpu_t65.vhd
set_global_assignment -name VERILOG_FILE ../rtl/cpu/cpu_port.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/c64_addr_decode.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/rom_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/ram_dp_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/rom_dp_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/mem/fifo_sync.v
set_global_assignment -name VERILOG_FILE ../rtl/drive/ce_fraction.v
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/drive_1541.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_multi.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_drv.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_logic.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_track.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_gcr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/c1541_direct_gcr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/drive/vendor/mister_c1541/iecdrv_misc.sv
set_global_assignment -name VHDL_FILE ../rtl/drive/vendor/mister_c1541/iecdrv_via6522.vhd
set_global_assignment -name VERILOG_FILE ../rtl/drive/vendor/mister_c1541/lfsr.v

# --- Takt (Tabelle 3-6) ----------------------------------------------------
set_location_assignment PIN_DJ35 -to CLOCK0_50
set_instance_assignment -name IO_STANDARD "1.1 V" -to CLOCK0_50

# --- Taster, low-aktiv, per Schmitt-Trigger entprellt (Tabelle 3-9) ---------
set_location_assignment PIN_C8  -to KEY[0]
set_location_assignment PIN_C11 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to KEY[1]

# --- Schiebeschalter, oben = 1, nicht entprellt (Tabelle 3-8) ---------------
set_location_assignment PIN_DK24 -to SW[0]
set_location_assignment PIN_DD24 -to SW[1]
set_location_assignment PIN_DD27 -to SW[2]
set_location_assignment PIN_DF27 -to SW[3]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[0]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[1]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[2]
set_instance_assignment -name IO_STANDARD "1.1 V" -to SW[3]

# --- LEDs, low-aktiv (Tabelle 3-10) -----------------------------------------
set_location_assignment PIN_DF35 -to LEDR[0]
set_location_assignment PIN_DJ32 -to LEDR[1]
set_location_assignment PIN_DN22 -to LEDR[2]
set_location_assignment PIN_DP23 -to LEDR[3]
set_location_assignment PIN_DN25 -to LEDR[4]
set_location_assignment PIN_DP25 -to LEDR[5]
set_location_assignment PIN_DJ27 -to LEDR[6]
set_location_assignment PIN_DP30 -to LEDR[7]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[0]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[1]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[2]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[3]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[4]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[5]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[6]
set_instance_assignment -name IO_STANDARD "1.1 V" -to LEDR[7]
# --- FPGA-UART über den Onboard-FTDI (Terasic golden_top.qsf) ----------------
set_location_assignment PIN_CJ1 -to FPGA_UART_TX
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_UART_TX
set_location_assignment PIN_BR19 -to FPGA_UART_RX
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to FPGA_UART_RX -entity de25_nano_top

# --- HDMI-Sender ADV7513 (Terasic golden_top.qsf) ----------------------------
set_location_assignment PIN_DJ24 -to HDMI_TX_CLK
set_instance_assignment -name IO_STANDARD "1.1 V" -to HDMI_TX_CLK -entity de25_nano_top
set_location_assignment PIN_BR11 -to HDMI_TX_HS
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_HS -entity de25_nano_top
set_location_assignment PIN_BR14 -to HDMI_TX_VS
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_VS -entity de25_nano_top
set_location_assignment PIN_CJ2 -to HDMI_TX_DE
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_DE -entity de25_nano_top
set_location_assignment PIN_BT1 -to HDMI_I2C_SCL
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_I2C_SCL -entity de25_nano_top
set_location_assignment PIN_BW2 -to HDMI_I2C_SDA
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_I2C_SDA -entity de25_nano_top
set_location_assignment PIN_CF2 -to HDMI_TX_INT
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_INT -entity de25_nano_top
set_location_assignment PIN_AV19 -to HDMI_TX_D[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[0] -entity de25_nano_top
set_location_assignment PIN_AT11 -to HDMI_TX_D[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[1] -entity de25_nano_top
set_location_assignment PIN_BE11 -to HDMI_TX_D[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[2] -entity de25_nano_top
set_location_assignment PIN_AV14 -to HDMI_TX_D[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[3] -entity de25_nano_top
set_location_assignment PIN_AT19 -to HDMI_TX_D[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[4] -entity de25_nano_top
