set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[16] -entity de25_nano_top
set_location_assignment PIN_DA1 -to HDMI_TX_D[17]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[17] -entity de25_nano_top
set_location_assignment PIN_BH19 -to HDMI_TX_D[18]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[18] -entity de25_nano_top
set_location_assignment PIN_CP2 -to HDMI_TX_D[19]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[19] -entity de25_nano_top
set_location_assignment PIN_CM1 -to HDMI_TX_D[20]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[20] -entity de25_nano_top
set_location_assignment PIN_DA2 -to HDMI_TX_D[21]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[21] -entity de25_nano_top
set_location_assignment PIN_CP1 -to HDMI_TX_D[22]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[22] -entity de25_nano_top
set_location_assignment PIN_CU2 -to HDMI_TX_D[23]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_TX_D[23] -entity de25_nano_top

# --- HDMI-Ton als I2S (Terasic golden_top.qsf) ------------------------------
set_location_assignment PIN_CF1 -to HDMI_MCLK
set_location_assignment PIN_BW1 -to HDMI_SCLK
set_location_assignment PIN_BR6 -to HDMI_LRCLK
set_location_assignment PIN_CB2 -to HDMI_I2S
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_MCLK -entity de25_nano_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_SCLK -entity de25_nano_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_LRCLK -entity de25_nano_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to HDMI_I2S -entity de25_nano_top
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"
set_global_assignment -name IP_FILE ip/reset_release.ip
set_global_assignment -name IP_FILE ip/pll_c64.ip
set_global_assignment -name IP_FILE ip/pll_video.ip
# Die eigene .sdc muss nach der PLL-IP stehen: Sie benutzt deren Takte, und
# Quartus liest die Dateien in dieser Reihenfolge.
set_global_assignment -name SDC_FILE de25_nano_c64.sdc
# Begruendete Ausnahmen fuer den Design Assistant
set_global_assignment -name DESIGN_ASSISTANT_WAIVER_FILE de25_nano_c64.dawf
set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name USE_SIGNALTAP_FILE de25_nano_c64.stp
set_global_assignment -name SIGNALTAP_FILE de25_nano_c64.stp
