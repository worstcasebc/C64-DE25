# de25_nano_c64_hps.qsf — wie quartus/de25_nano_c64.qsf, dazu das HPS (siehe README.md)
# Pins laut DE25-Nano User Manual und Terasic golden_top.qsf, siehe docs/pinout.md

set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY de25_nano_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

