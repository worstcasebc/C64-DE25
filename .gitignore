# Simulation
tb/build/

# Quartus-Erzeugnisse
quartus/qdb/
quartus/tmp-clearbox/
quartus/output_files/
quartus/dni/
quartus/*.qws
quartus/*.rpt
quartus/*.summary
quartus/*.bak

# ROMs (Urheberrecht) — nur README und .gitignore bleiben im Repo
roms/*
!roms/README.md
!roms/.gitignore

# Python / Editor
__pycache__/
.vscode/

# Generierte IP-Ausgaben (die .ip-Dateien selbst bleiben im Repo)
quartus/ip/*/
quartus/ip/**/*.bak
quartus/ip/.qsys_edit/

# Lokale Werkzeuge (cc65)
tools/

# Assembler-Erzeugnisse
sw/asm/build/

# Fehlerbericht, den Quartus bei internen Fehlern schreibt
quartus/serv_req_info.txt

# Testprogramme aus fremden Veröffentlichungen (nicht einchecken)
sw/prg/

# HPS-Projekt: nur die eigenen Dateien einchecken. Alles andere ist Erzeugnis
# oder stammt aus Terasics GHRD und darf nicht weitergegeben werden
# (holen mit sw/py/fetch_ghrd.py, siehe quartus_hps/README.md).
quartus_hps/**
!quartus_hps/README.md
!quartus_hps/*.qpf
!quartus_hps/*.qsf
!quartus_hps/*.bat
